    "Your goal is to build a profitable global airline. You'll start small — one aircraft, one route — and grow it flight by flight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ziel ist eine profitable, weltweite Fluggesellschaft. Du startest klein — ein Flugzeug, eine Route — und wächst Flug für Flug."
          }
        }
      }
    },
