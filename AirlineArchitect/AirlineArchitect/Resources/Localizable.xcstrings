      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Anteil"
          }
        }
      }
    },
    "Your starting map focuses here — you can still fly anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Startkarte zeigt diese Region – fliegen kannst du trotzdem überallhin."
