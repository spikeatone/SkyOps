    "%@ is flying %@. If you don't put another aircraft on the route, it closes when you hand this one back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fliegt %@. Wenn du kein anderes Flugzeug auf die Route setzt, schließt sie, sobald du dieses zurückgibst."
          }
        }
      }
    },
    "%@ is flying %@. If you don't put another aircraft on the route, it closes when you sell it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fliegt %@. Wenn du kein anderes Flugzeug auf die Route setzt, schließt sie, sobald du es verkaufst."
