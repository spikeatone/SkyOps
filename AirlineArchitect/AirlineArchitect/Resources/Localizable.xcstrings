          }
        }
      }
    },
    "A genuine price drop still helps you — the hedge only removes the upside risk, not the downside benefit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein echter Preisrückgang nützt dir weiterhin — der Hedge nimmt nur das Aufwärtsrisiko, nicht den Abwärtsvorteil."
