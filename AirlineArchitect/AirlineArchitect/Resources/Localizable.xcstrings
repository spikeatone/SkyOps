    "One-time purchase — no subscription. Unlocks the full game forever and restores on any device signed in to the same Apple Account. Payment is charged to your Apple Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf – kein Abo. Schaltet das komplette Spiel für immer frei und wird auf jedem Gerät wiederhergestellt, das mit demselben Apple-Account angemeldet ist. Die Zahlung wird deinem Apple-Account belastet."
          }
        }
      }
    },
